{
  "name": "bolyra-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Source for bolyra.ai/playground: a prebuilt static page that verifies real @bolyra/receipts in the browser and simulates spend policy honestly. Output is landing/playground.html.",
  "type": "module",
  "config": {
    "receiptsVersion": "0.11.0",
    "cliVersion": "0.9.0",
    "paymentProtocolsVersion": "0.9.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test test/unit/*.test.js test/build.test.js test/artifact.test.js",
    "test:browser": "node test/browser.mjs",
    "test:cli": "node --test test/cli.test.js"
  },
  "dependencies": {
    "@bolyra/receipts": "0.11.0",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@bolyra/mpp": "0.7.0",
    "@bolyra/payment-protocols": "0.9.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "license": "Apache-2.0",
  "overrides": {
    "ws": "^8.21.3",
    "underscore": "^1.13.8"
  }
}
