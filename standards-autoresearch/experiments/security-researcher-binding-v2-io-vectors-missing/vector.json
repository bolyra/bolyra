{
  "vectors": [
    {
      "id": "external-verifier-deny-binding-v1-five-field",
      "description": "IO-contract for Binding v2 (\u00a74.1, \u00a79, \u00a711): the golden `allow-agent-only` bundle pinned at a4f546f (real Groth16 AgentPolicy proof, credential, scope anchor all valid) re-issued with an obsolete five-field binding v1 \u2014 `agent_name`, `project_key`, `program`, `model`, `capabilities`, no `expiry` \u2014 genuinely signed by the golden operator key (OPERATOR_PRIV=42n) under the pre-revision domain tag `bolyra.external-verifier.binding.v1`, i.e. exactly what a pre-v2 issuer emitted. The spawned verifier MUST deny `unsupported_version` at exit 0 with no compat mode: the missing `expiry` is detected at binding parse, before the signature is checked, so a historically valid v1 signature earns no credit. Catches a verifier that still accepts v1 bindings (the classical re-anchoring gap), one that reports the exact five-field shape as `invalid_bundle` (\u00a74.1 reserves that for ill-typed/extra-field bindings; only the well-formed five-field shape is the re-issue signal), and one that treats the code as a negotiation hook (\u00a711).",
      "type": "external_verifier",
      "inputs": {
        "request_fixture": "deny-binding-v1-five-field",
        "roots_file": "roots.json",
        "capability_map": "capability-map.json",
        "nonce_mode": "local"
      },
      "expected": {
        "result": "PASS",
        "verdict": "deny",
        "code": "unsupported_version"
      }
    },
    {
      "id": "external-verifier-deny-binding-expiry-mismatch",
      "description": "IO-contract for the \u00a74.1 equality rule: the golden `allow-agent-only` bundle pinned at a4f546f whose six-field binding v2 carries `expiry: 4133980800` and is VALIDLY re-signed under `bolyra.external-verifier.binding.v2` by the golden operator key, while the revealed credential (and the proof's scope anchor, publicSignals[2]) commit to `expiry: 4102444800`. Signature verification succeeds; the verifier MUST then deny `invalid_bundle` because `binding.expiry != credential.expiry`. Isolates the equality check from signature failure: a verifier that only checks the signature allows (expiry re-anchored by a cooperating or compromised issuer key), one that returns `invalid_signature` never reached the equality check, and one that returns `expired` skipped \u00a74.1 and fell through to the strict clock check (`now_unix` 1751990400 is below both expiries, so `expired` cannot be the honest answer).",
      "type": "external_verifier",
      "inputs": {
        "request_fixture": "deny-binding-expiry-mismatch",
        "roots_file": "roots.json",
        "capability_map": "capability-map.json",
        "nonce_mode": "local"
      },
      "expected": {
        "result": "PASS",
        "verdict": "deny",
        "code": "invalid_bundle"
      }
    },
    {
      "id": "external-verifier-deny-expiry-equal-boundary",
      "description": "IO-contract for the \u00a79 `expired` row (strict comparison): the golden `allow-agent-only` bundle pinned at a4f546f byte-for-byte \u2014 identical bundle string, signature and request \u2014 with only the host clock moved to `now_unix: 4102444800`, equal to `credential.expiry`, `binding.expiry` and therefore `effective_expiry`. \u00a79 defines expiry as `now_unix >= effective_expiry`, so the equality boundary MUST deny `expired` at exit 0. Pairs with `external-verifier-allow-agent` (same bundle, `now_unix` 1751990400 \u2192 allow) so the clock is the only variable; catches an off-by-one verifier that compares with `>` and allows at the boundary, the classic one-second re-use window.",
      "type": "external_verifier",
      "inputs": {
        "request_fixture": "deny-expiry-equal-boundary",
        "roots_file": "roots.json",
        "capability_map": "capability-map.json",
        "nonce_mode": "local"
      },
      "expected": {
        "result": "PASS",
        "verdict": "deny",
        "code": "expired"
      }
    }
  ],
